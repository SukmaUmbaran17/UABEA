name: Inspect ASTC Project

on:
  workflow_dispatch:

jobs:
  inspect:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Show repository structure
        shell: bash
        run: |
          echo "======================================"
          echo "REPOSITORY STRUCTURE"
          echo "======================================"

          pwd

          echo ""
          echo "=== CSProj ==="
          find . -type f -name "*.csproj" -print

          echo ""
          echo "=== Program.cs ==="
          find . -type f -name "Program.cs" -print

          echo ""
          echo "=== ASTC files ==="
          find . -type f | grep -i "astc" || true

          echo ""
          echo "=== Texture DLL ==="
          find . -type f -name "AssetsTools.NET.Texture.dll" -print

          echo ""
          echo "=== TOP LEVEL ==="
          find . -maxdepth 2 -type f | sort
