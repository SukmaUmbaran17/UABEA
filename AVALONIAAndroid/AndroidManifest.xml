<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com" 
          package="com.uabea.nativeandroid" 
          android:versionCode="1" 
          android:versionName="1.0">
          
    <!-- Menentukan batas minimal sistem Android (Lollipop ke atas) -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    
    <!-- Hak Akses Memori Internal HP -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Menggunakan penutup tag application minimalis tanpa properti kustom -->
    <application android:allowBackup="true" 
                 android:label="UABEA Android Native"
                 android:requestLegacyExternalStorage="true">
    </application>
</manifest>
